# Offline pipelines only. Copy to .env (gitignored) and fill in from
# Supabase dashboard → Project Settings → API Keys.
SUPABASE_URL=
# Secret key (sb_secret_…). Bypasses RLS. Never put this in Streamlit secrets.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_…). Used only by tests/rls_check.py.
SUPABASE_PUBLISHABLE_KEY=
